{
  "name": "style-doctor-site",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "check:react": "react-doctor",
    "check:prose": "style-doctor",
    "check": "npm run lint && npm run check:react && npm run check:prose"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "style-doctor": "^0.4.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.83.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "react-doctor": "^0.9.14"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
