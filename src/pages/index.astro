---
import "../styles/global.css";
import geistSansUrl from "@fontsource/geist-sans/files/geist-sans-latin-400-normal.woff2?url";
import geistSansBoldUrl from "@fontsource/geist-sans/files/geist-sans-latin-600-normal.woff2?url";
import geistMonoUrl from "@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url";
import { findInText, scoreLabel } from "style-doctor/rules.js";
import { scoreOf, scoreTone, diagnosticsListHtml, categoryCountsHtml } from "../lib/render";
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";

const styleDoctorPkgPath = createRequire(import.meta.url)
  .resolve("style-doctor")
  .replace(/cli\.js$/, "package.json");
const { version } = JSON.parse(readFileSync(styleDoctorPkgPath, "utf8"));

const EXAMPLE = `In today's world, it's important to note that we must delve into the rich tapestry of modern software. This isn't just a tool, but a game-changer that will unlock the potential of your writing. It stands as a testament to seamless, robust, cutting-edge engineering.

## Why This Matters And Why It Is Important

- **Speed:** blazing fast across every workflow
- **Clarity:** a meticulous, intricate interplay of ideas

I hope this helps! Let me know if you have questions.`;

// Precomputed at build time so the score/highlights/diagnostics ship in the
// initial HTML instead of popping in once client JS runs.
const { diagnostics, words } = findInText(EXAMPLE, "input.md", {});
const score = scoreOf(diagnostics, words);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href={geistSansUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={geistSansBoldUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={geistMonoUrl} crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>Style Doctor</title>
    <meta
      name="description"
      content="Paste your prose and see every AI-writing tell highlighted live, in your browser."
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://style-doctor.pages.dev/" />
    <meta property="og:title" content="Style Doctor" />
    <meta
      property="og:description"
      content="Paste your prose and see every AI-writing tell highlighted live, in your browser."
    />
    <meta property="og:image" content="https://style-doctor.pages.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Style Doctor" />
    <meta
      name="twitter:description"
      content="Paste your prose and see every AI-writing tell highlighted live, in your browser."
    />
    <meta name="twitter:image" content="https://style-doctor.pages.dev/og.png" />
  </head>
  <body class="flex min-h-[100dvh] flex-col lg:h-[100dvh] lg:overflow-hidden">
    <header
      class="flex h-14 shrink-0 items-center justify-between border-b px-6"
      style="border-color: var(--border); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px);"
    >
      <a href="/" class="flex items-baseline gap-2 font-mono text-[15px] font-medium tracking-tight" style="color: var(--text);">
        style<span style="color: var(--accent);">·</span>doctor
        <span class="text-xs font-normal" style="color: var(--text-dim);">v{version}</span>
      </a>
      <nav class="flex items-center gap-5 text-sm" style="color: var(--text-dim);">
        <a href="https://www.npmjs.com/package/style-doctor" class="hover:opacity-70">npm</a>
        <a href="https://github.com/baronunread/style-doctor" class="hover:opacity-70">GitHub</a>
      </nav>
    </header>

    <main class="mx-auto flex w-full max-w-[1400px] min-h-0 flex-1 flex-col px-6 py-6">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
        <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--text);">
          Find the AI in your writing.
        </h1>
        <p class="text-sm" style="color: var(--text-dim);">
          Paste text, get every LLM tell highlighted live. Runs in your browser, nothing is sent anywhere.
        </p>
      </div>

      <div class="mt-4 grid min-h-0 flex-1 grid-cols-1 gap-4 lg:grid-cols-[1fr_360px]">
        <div
          class="flex min-h-[320px] flex-col overflow-hidden rounded-lg border"
          style="border-color: var(--border); background: var(--surface);"
        >
          <div id="editor-mount" class="min-h-0 flex-1" set:text={EXAMPLE} />
        </div>

        <aside class="flex min-h-[320px] flex-col overflow-hidden rounded-lg border" style="border-color: var(--border); background: var(--surface);">
          <div class="border-b p-4" style="border-color: var(--border);">
            <div class="flex items-baseline gap-2">
              <span id="score-value" class="font-mono text-3xl font-semibold" data-tone={scoreTone(score)}>{score}</span>
              <span class="text-sm" style="color: var(--text-dim);">/ 100</span>
              <span id="score-label" class="text-sm font-medium" style="color: var(--text-dim);">{scoreLabel(score)}</span>
            </div>
            <div id="word-count" class="mt-2 font-mono text-xs" style="color: var(--text-dim);">
              {words} word{words === 1 ? "" : "s"} · {diagnostics.length} finding{diagnostics.length === 1 ? "" : "s"}
            </div>
            <div id="category-counts" class="mt-2 flex flex-wrap gap-1.5" set:html={categoryCountsHtml(diagnostics)} />
          </div>
          <div id="diagnostics-list" class="min-h-0 flex-1 overflow-y-auto" set:html={diagnosticsListHtml(diagnostics)} />
        </aside>
      </div>
    </main>

    <footer
      class="shrink-0 border-t px-6 py-3 text-xs"
      style="border-color: var(--border); color: var(--text-dim);"
    >
      <div class="mx-auto flex max-w-[1400px] items-center justify-between">
        <span>Andrea Bruno</span>
        <a href="https://github.com/baronunread/style-doctor/blob/main/LICENSE" class="hover:opacity-70">MIT License</a>
      </div>
    </footer>

    <script>
      import "../scripts/doctor.ts";
    </script>
  </body>
</html>

<style is:global>
  #editor-mount {
    padding: 1rem;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.65;
    white-space: pre-wrap;
    word-break: break-word;
    /* Invisible until doctor.ts reveals it post-mount. Matching a plain
       div's text layout against CodeMirror's own rendering engine pixel
       for pixel (padding, scrollbar gutter, font metrics, ...) is a losing
       game; simplest correct fix is to never show the mismatched state. */
    opacity: 0;
    transition: opacity 120ms ease;
  }
  #editor-mount.ready {
    opacity: 1;
  }
  #editor-mount .cm-editor {
    height: 100%;
  }

  .category-chip {
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    font-size: 11px;
    border: 1px solid var(--border);
    color: var(--text-dim);
  }
  .category-chip b {
    color: var(--text);
    font-weight: 600;
  }

  .finding {
    border-bottom: 1px solid var(--border);
  }
  .finding summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    padding: 0.55rem 1rem;
  }
  .finding summary::-webkit-details-marker {
    display: none;
  }
  .finding summary::marker {
    content: "";
  }
  .finding summary::before {
    content: "\203A"; /* › */
    display: inline-block;
    width: 0.75rem;
    color: var(--text-dim);
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }
  .finding[open] summary::before {
    transform: rotate(90deg);
  }
  .finding-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .finding.sev-error .finding-dot {
    background: var(--error);
  }
  .finding.sev-warning .finding-dot {
    background: var(--warning);
  }
  .finding-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    flex: 1;
    min-width: 0;
  }
  .finding-rule {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-dim);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .finding-body {
    padding: 0 1rem 0.85rem 2.25rem;
  }
  .finding-message,
  .finding-help {
    font-size: 12.5px;
    color: var(--text-dim);
    line-height: 1.5;
  }
  .finding-help {
    margin-top: 0.35rem;
  }
  .finding-lines {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
  }

  .empty-state {
    padding: 1.5rem 1rem;
    font-size: 13px;
    color: var(--text-dim);
    text-align: center;
  }

  #score-value[data-tone="empty"] {
    color: var(--text-dim);
  }
  #score-value[data-tone="excellent"] {
    color: #16a34a;
  }
  #score-value[data-tone="healthy"] {
    color: var(--accent);
  }
  #score-value[data-tone="needs-work"] {
    color: var(--warning);
  }
  #score-value[data-tone="critical"] {
    color: var(--error);
  }
</style>
